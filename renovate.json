{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>muhlba91/renovate-config",
        "github>muhlba91/renovate-config:automerge(patch)",
        "github>muhlba91/renovate-config:automerge(minor)"
    ],
    "enabledManagers": [
        "github-actions",
        "pre-commit",
        "poetry",
        "mise"
    ],
    "packageRules": [
        {
            "description": "Renovate cannot regenerate the uv dependency graph mise keeps for pipx:poetry; bump these manually with `mise lock --bump`",
            "matchManagers": ["mise"],
            "matchPackageNames": ["pipx:poetry", "uv"],
            "enabled": false
        },
        {
            "description": "Poetry's mise lock is pinned to Python 3.14 (tool option python = \"3.14\"); a Python minor upgrade is a manual change together with that option",
            "matchManagers": ["mise"],
            "matchPackageNames": ["python"],
            "allowedVersions": "<3.15.0"
        }
    ]
}
